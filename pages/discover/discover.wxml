<view class="page-shell discover-page">
  <view class="discover-header panel">
    <view class="eyebrow">SONGSONG MENU</view>
    <view class="title">今天想做哪一道菜</view>
    <view class="subtitle">把家常菜整理得更清爽，也让每天吃什么更容易决定。</view>
    <view wx:if="{{featuredRecipe}}" class="hero hero--featured">
      <image class="hero-image" src="{{featuredRecipe.photoUrl}}" mode="aspectFill" />
      <view class="hero-overlay">
        <view class="hero-badge">最新收录</view>
        <view class="hero-title">{{featuredRecipe.title}}</view>
        <view class="hero-copy">{{featuredRecipe.summary}}</view>
      </view>
    </view>
    <view wx:else class="hero">
      <view class="hero-badge">今日推荐</view>
      <view class="hero-title">从一张照片开始，慢慢建立你的菜谱库</view>
    </view>
  </view>

  <scroll-view class="category-scroll" scroll-x="true">
    <view class="category-row">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="category-chip {{activeCategory === item ? 'category-chip--active' : ''}}"
        data-category="{{item}}"
        bindtap="onCategoryTap"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <view class="recipe-list">
    <view wx:if="{{loading}}" class="panel state-card">
      <view class="state-title">正在加载菜谱</view>
      <view class="state-text">稍等一下，给你整理一份更清爽的菜单。</view>
    </view>

    <view wx:elif="{{errorText}}" class="panel state-card">
      <view class="state-title">加载出了点问题</view>
      <view class="state-text">{{errorText}}</view>
      <button class="secondary-button state-button" bindtap="onRetryTap">重新加载</button>
    </view>

    <view wx:for="{{recipes}}" wx:key="id" class="panel recipe-card" data-id="{{item.id}}" bindtap="onRecipeTap">
      <image class="recipe-image" src="{{item.photoUrl}}" mode="aspectFill" />
      <view class="recipe-body">
        <view class="recipe-title">{{item.title}}</view>
        <view class="recipe-summary">{{item.summary}}</view>
      </view>
    </view>

    <view wx:if="{{!loading && !errorText && recipes.length === 0}}" class="panel empty-card">
      <view class="empty-title">还没有内容</view>
      <view class="empty-text">{{emptyText}}</view>
    </view>
  </view>
</view>
