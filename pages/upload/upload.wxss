.upload-page {
  padding: 32rpx;
}

.upload-panel {
  padding: 32rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: #666666;
  line-height: 1.6;
}

.upload-topbar {
  padding: 8rpx 4rpx 4rpx;
}

.mode-badge {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff1f6;
  color: #c46f95;
  font-size: 22rpx;
  border: 1rpx solid #f3d7e2;
}

.workspace-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #fffdfd 0%, #fff7fa 100%);
  border: 1rpx solid #f3dce5;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
}

.section-note {
  color: #777777;
  font-size: 24rpx;
  line-height: 1.6;
}

.upload-box {
  height: 260rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  border: 1rpx dashed #e7bfd0;
  background: linear-gradient(135deg, #fff1f6, #ffe2ec);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #444444;
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  text-align: center;
  padding: 0 36rpx;
}

.upload-placeholder-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #222222;
}

.upload-placeholder-text {
  margin-top: 10rpx;
  color: #666666;
  font-size: 24rpx;
}

.ai-card {
  background: linear-gradient(180deg, #fffafb 0%, #fff4f8 100%);
}

.secondary-button {
  margin-top: 20rpx;
}

.ai-button {
  margin-top: 20rpx;
}

.ai-tip {
  margin-top: 16rpx;
  color: #666666;
  font-size: 24rpx;
}

.ai-note {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff7fa;
  color: #666666;
  font-size: 24rpx;
  line-height: 1.6;
  border: 1rpx solid #f3dce5;
}

.category-label {
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #222222;
}

.category-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.category-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #fff4f8;
  border: 1rpx solid #f2dce6;
  color: #111111;
  font-size: 24rpx;
}

.category-chip--active {
  background: #111111;
  border-color: #111111;
  color: #ffffff;
}

.input {
  display: block;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #eed8e2;
  border-radius: 20rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.error {
  margin-top: 16rpx;
  color: #d34b6b;
  font-size: 24rpx;
}

.submit-button {
  margin-top: 24rpx;
}
