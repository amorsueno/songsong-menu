.my-page {
  padding: 32rpx;
}

.profile-panel {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.subtitle {
  margin-top: 12rpx;
  color: #666666;
}

.logout-button {
  margin-top: 24rpx;
}

.my-hero {
  position: relative;
  margin-bottom: 24rpx;
  overflow: hidden;
  min-height: 340rpx;
  background: #f7edf1;
}

.my-hero-image {
  width: 100%;
  height: 340rpx;
}

.my-hero-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28rpx;
  background: linear-gradient(180deg, rgba(17, 17, 17, 0.04) 0%, rgba(17, 17, 17, 0.72) 100%);
}

.my-hero-badge {
  width: fit-content;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #c46f95;
  font-size: 22rpx;
}

.my-hero-title {
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.my-hero-copy {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.6;
}

.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recipe-card {
  overflow: hidden;
}

.recipe-image {
  width: 100%;
  height: 240rpx;
  background: #f6f6f6;
}

.recipe-body {
  padding: 20rpx 24rpx 24rpx;
}

.empty-state {
  text-align: center;
}

.state-button {
  margin-top: 24rpx;
}

.recipe-title {
  font-size: 32rpx;
  font-weight: 700;
}

.recipe-summary {
  margin-top: 8rpx;
  color: #666666;
  line-height: 1.6;
}
