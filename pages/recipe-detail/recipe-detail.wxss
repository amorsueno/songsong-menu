.detail-page {
  padding: 32rpx;
}

.detail-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-image {
  width: 100%;
  height: 360rpx;
  overflow: hidden;
}

.detail-panel {
  padding: 28rpx;
}

.detail-meta {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff4f8;
  color: #c46f95;
  font-size: 22rpx;
}

.detail-title {
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}

.detail-button-inline {
  margin-top: 20rpx;
}

.detail-section-title {
  margin-top: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #222222;
}

.detail-text {
  margin-top: 12rpx;
  color: #666666;
  line-height: 1.7;
}

.detail-state {
  padding: 40rpx 32rpx;
  text-align: center;
}

.detail-state-title {
  font-size: 30rpx;
  font-weight: 700;
}

.detail-state-text {
  margin-top: 12rpx;
  color: #777777;
  line-height: 1.6;
}

.detail-button {
  margin-top: 24rpx;
}
